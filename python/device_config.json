{
  "system_name": "SOC CHESS Live Capture & Threat Detection Engine",
  "version": "2.0.0",
  "tagline": "Know the Adversary's Next Move",
  "capture": {
    "interface": "auto",
    "promiscuous": true,
    "bpf_filter": "ip and (tcp or udp or icmp)",
    "buffer_size_mb": 64,
    "snaplen": 65535,
    "timeout_ms": 1000
  },
  "flow_aggregator": {
    "flow_timeout_seconds": 15,
    "max_active_flows": 50000,
    "flush_interval_seconds": 2,
    "batch_inference_size": 256
  },
  "detection_thresholds": {
    "alert_min_confidence": 0.65,
    "critical_threshold": 0.90,
    "high_threshold": 0.75,
    "medium_threshold": 0.50,
    "auto_mitigation": false
  },
  "log_monitoring": {
    "enabled": true,
    "poll_interval_seconds": 3,
    "watch_directories": [
      "uploads",
      "scratch"
    ]
  }
}
