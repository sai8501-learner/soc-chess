# SOC CHESS — ENVIRONMENT EXAMPLE CONFIGURATION
APP_NAME=SOC_CHESS
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
FRONTEND_PORT=5173

# MySQL Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=soc_chess
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Wireshark & TShark Host Paths
WIRESHARK_PATH=C:\Program Files\Wireshark\Wireshark.exe
TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
DEFAULT_INTERFACE=Ethernet 7

# Splunk Enterprise Configuration
SPLUNK_HOST=127.0.0.1
SPLUNK_PORT=8089
SPLUNK_WEB_URL=http://127.0.0.1:8000
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
SPLUNK_INDEX=main

# Security & Model
AUTH_ENABLED=true
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
ACCESS_TOKEN_TTL_MINUTES=480
MODEL_DIR=ml/models
DATASET_DIR=datasets
DATASET_ROOT=datasets

# ─────────────────────────────────────────────────────────────────
# NVIDIA NIM LLM SOC ANALYST GATEWAY
# ─────────────────────────────────────────────────────────────────
# Replace with your real NVIDIA API key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro-0813
KIMI_MODEL=moonshotai/kimi-k3
LLM_ENABLED=true
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000

# ─────────────────────────────────────────────────────────────────
# THREAT INTELLIGENCE API KEYS (Optional — enables live feeds)
# ─────────────────────────────────────────────────────────────────
# ABUSEIPDB_API_KEY=your_abuseipdb_key_here
# VIRUSTOTAL_API_KEY=your_virustotal_key_here
# OTX_API_KEY=your_otx_key_here
TI_CACHE_TTL_SECONDS=3600

# Apache Spark runtime
JAVA_HOME=C:\Program Files\Java\jdk-21
PYSPARK_PYTHON=C:\wamp64\www\soc-chess\.venv\Scripts\python.exe
PYSPARK_DRIVER_PYTHON=C:\wamp64\www\soc-chess\.venv\Scripts\python.exe
SPARK_APP_NAME=SOC_Chess_BigData_Pipeline
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_PARTITIONS=8

# Optional model, risk, and provider overrides
MLP_MAX_ITER=200
MLP_LEARNING_RATE=0.001
RISK_LOW_MAX=24
RISK_MED_MAX=49
RISK_HIGH_MAX=74
RISK_CRITICAL_MIN=75
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENAI_API_KEY=
GEMINI_API_KEY=
